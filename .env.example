# App configuration
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database Configuration
# Default WSL Docker mapped port is 5435 to avoid conflicts with other local Postgres instances
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5435/postpulse?schema=public"
POSTGRES_PORT=5435
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postpulse

# GitHub Integration (Optional - simulated mode works without tokens)
GITHUB_WEBHOOK_SECRET=dev_secret_content_engine_123
GITHUB_PERSONAL_ACCESS_TOKEN=

# LLM Providers (Configure at least one, or use Built-in Calibrated Engine)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini
