# App configuration
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GitHub Integration (Optional - simulated mode works without tokens)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_if_fetching_private_repos

# LLM Providers (Configure at least one, or use Built-in Calibrated Engine)
# Priority: OPENAI_API_KEY -> ANTHROPIC_API_KEY -> GEMINI_API_KEY -> Built-in Local Engine
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Model overrides (optional)
LLM_MODEL=gpt-4o-mini
