# App configuration
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# Database Configuration
# ==============================================================================

# 1. Local Development (SQLite - Zero Setup, Default):
DATABASE_URL="file:./dev.db"

# 2. Production (Neon Serverless PostgreSQL):
# Grab your pooled connection string from the Neon Console (Dashboard -> Connection Details):
# DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"

# Direct unpooled connection for migrations (optional, from Neon Console):
# DATABASE_URL_UNPOOLED="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require"

# ==============================================================================
# GitHub Integration
# ==============================================================================
# Webhook secret for HMAC-SHA256 signature validation
GITHUB_WEBHOOK_SECRET=dev_secret_content_engine_123
# Optional GitHub Personal Access Token (for higher rate limits importing public repos)
GITHUB_PERSONAL_ACCESS_TOKEN=

# ==============================================================================
# LLM Providers (Optional - Built-in Calibrated Engine handles fallback offline)
# ==============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini
