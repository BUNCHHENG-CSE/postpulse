{
  "name": "tct-postpulse",
  "version": "1.0.0",
  "private": true,
  "description": "TCT PostPulse — Build-in-Public Content Engine for Indie Developers (Next.js Full-Stack + Neon PostgreSQL + Prisma + Local SQLite)",
  "scripts": {
    "dev": "node ./scripts/prepare-db.mjs && node ./node_modules/next/dist/bin/next dev",
    "build": "node ./scripts/prepare-db.mjs && node ./node_modules/prisma/build/index.js generate && node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "tsc --noEmit",
    "typecheck": "node ./node_modules/next/dist/bin/next typegen && tsc --noEmit",
    "test": "bun ./scripts/test-engine.mjs && bun ./scripts/test-endpoints.mjs",
    "db:prepare": "node ./scripts/prepare-db.mjs",
    "db:generate": "node ./scripts/prepare-db.mjs && node ./node_modules/prisma/build/index.js generate",
    "db:push": "node ./scripts/prepare-db.mjs && node ./node_modules/prisma/build/index.js db push",
    "db:seed": "node ./scripts/seed.mjs",
    "db:verify": "node ./scripts/verify-db.mjs",
    "db:sqlite": "node ./scripts/prepare-db.mjs sqlite && node ./node_modules/prisma/build/index.js generate",
    "db:postgres": "node ./scripts/prepare-db.mjs postgresql && node ./node_modules/prisma/build/index.js generate",
    "db:neon": "node ./scripts/prepare-db.mjs postgresql && node ./node_modules/prisma/build/index.js generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "6.19.3",
    "@prisma/client": "^6.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.16.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
