generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id              String   @id
  type            String   @default("commit")
  repo            String
  branch          String   @default("main")
  authorName      String
  authorUsername  String
  authorAvatarUrl String?
  timestamp       DateTime @default(now())
  title           String
  description     String?  @db.Text
  sha             String
  shortSha        String
  url             String
  additions       Int      @default(0)
  deletions       Int      @default(0)
  totalFiles      Int      @default(1)
  filesJson       Json     @default("[]")
  rawDiffSnippet  String?  @db.Text
  worthinessScore Int      @default(50)
  category        String   @default("chore_internal")
  reasons         Json     @default("[]")
  recommendedHook String?
  status          String   @default("pending") // pending | drafted | published | dismissed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  drafts          Draft[]

  @@index([category])
  @@index([worthinessScore(sort: Desc)])
  @@index([status])
  @@index([timestamp(sort: Desc)])
  @@index([repo])
}

model Draft {
  id                String   @id
  eventId           String
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  format            String   // technical_lesson | build_in_public | changelog
  targetPlatform    String   // reddit | indie_hackers | linkedin | x_twitter | changelog | dev_to
  platformName      String
  title             String
  hook              String?  @db.Text
  content           String   @db.Text
  tone              String   @default("authentic_raw")
  wordCount         Int      @default(0)
  publishChecklist  Json     @default("[]")
  estimatedReadTime String   @default("1 min read")
  isEdited          Boolean  @default(false)
  publishedUrl      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([eventId])
  @@index([format])
  @@index([targetPlatform])
}

model Settings {
  id                  String   @id @default("default")
  productName         String   @default("PostPulse")
  productTagline      String   @default("Turn your git commits into viral developer content automatically")
  targetAudience      String   @default("Indie hackers, micro-SaaS founders, and full-stack software engineers")
  founderVoiceBio     String   @default("Solo developer, ex-infrastructure engineer, no-nonsense technical tone with zero marketing hype") @db.Text
  repoUrl             String   @default("https://github.com/developer/postpulse")
  githubWebhookSecret String   @default("dev_secret_content_engine_123")
  githubToken         String?
  openaiApiKey        String?
  anthropicApiKey     String?
  geminiApiKey        String?
  preferredModel      String   @default("gpt-4o-mini")
  minScoreToDraft     Int      @default(50)
  autoDraftOnWebhook  Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

model ValidationGrade {
  id                String   @id
  eventId           String   @unique
  grade             String   // ready_as_is | light_edits | heavy_edits | unpublishable
  developerFeedback String?  @db.Text
  ratedAt           DateTime @default(now())

  @@index([grade])
}
